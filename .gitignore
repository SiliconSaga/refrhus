# Generated artifact — repacked from sh3d-internals/ via the realm's pack.sh.
*.sh3d

# Serialized Home blob — redundant with Home.xml (SH3D reads it in priority) and
# re-churned on every save. normalize.sh strips it on unpack; ignore it too so a stray
# manual unzip can't re-track it.
sh3d-internals/Home

# Jekyll build output and the vendored gem tree. `Gemfile.lock` is NOT ignored —
# it is what pins the local build to the same versions CI resolves.
_site/
.jekyll-cache/
.jekyll-metadata
vendor/

# Byte-code from running the tools/ scripts directly (subschematic.py gets
# imported by ad-hoc checks, which leaves a cache beside it).
__pycache__/

# OS / temp
.DS_Store
